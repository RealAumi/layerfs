{
  "name": "@layerfs/sdk",
  "version": "0.1.7",
  "description": "LayerFS JavaScript SDK: Branch files, Sandboxes and Workspaces over the native layerfs-api binding",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./operator": "./operator/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:native": "node scripts/build-native.mjs",
    "build:isolated": "python3 ../../tools/worktree.py build",
    "test:isolated": "python3 ../../tools/worktree.py run"
  }
}
